"""Diccionario Inteligente con Árbol Binario de Búsqueda (BST).

- Cada nodo guarda un objeto Palabra (texto + definición).
- El orden es alfabético, ignorando mayúsculas y tildes (la ñ va entre n y o).
- Soporta búsqueda exacta, autocompletado por prefijo y listado en orden.
"""

import unicodedata


def normalizar(texto: str) -> str:
    """Clave de comparación: minúsculas, sin tildes, con 'ñ' ordenada después de 'n'."""
    texto = texto.strip().lower().replace("ñ", "n{")  # '{' > 'z' pero < 'o'... tras la 'n'
    texto = unicodedata.normalize("NFD", texto)
    return "".join(c for c in texto if unicodedata.category(c) != "Mn")


class Palabra:
    def __init__(self, texto: str, definicion: str):
        self.texto = texto
        self.definicion = definicion
        self.clave = normalizar(texto)

    def __str__(self):
        return f"{self.texto}: {self.definicion}"


class Nodo:
    def __init__(self, palabra: Palabra):
        self.palabra = palabra
        self.izq = None
        self.der = None


class DiccionarioBST:
    def __init__(self):
        self.raiz = None
        self.tamano = 0

    # ---------- Inserción ----------
    def insertar(self, palabra: Palabra) -> None:
        """Inserta la palabra; si ya existe, actualiza su definición."""
        nuevo = Nodo(palabra)
        if self.raiz is None:
            self.raiz = nuevo
            self.tamano = 1
            return
        actual = self.raiz
        while True:
            if palabra.clave == actual.palabra.clave:
                actual.palabra = palabra
                return
            if palabra.clave < actual.palabra.clave:
                if actual.izq is None:
                    actual.izq = nuevo
                    break
                actual = actual.izq
            else:
                if actual.der is None:
                    actual.der = nuevo
                    break
                actual = actual.der
        self.tamano += 1

    def cargar_balanceado(self, palabras: list) -> None:
        """Inserta empezando por la mediana para evitar un árbol degenerado."""
        ordenadas = sorted(palabras, key=lambda p: p.clave)

        def insertar_rango(lo, hi):
            if lo > hi:
                return
            medio = (lo + hi) // 2
            self.insertar(ordenadas[medio])
            insertar_rango(lo, medio - 1)
            insertar_rango(medio + 1, hi)

        insertar_rango(0, len(ordenadas) - 1)

    # ---------- Búsqueda exacta ----------
    def buscar(self, texto: str):
        clave = normalizar(texto)
        actual = self.raiz
        while actual:
            if clave == actual.palabra.clave:
                return actual.palabra
            actual = actual.izq if clave < actual.palabra.clave else actual.der
        return None

    # ---------- Búsqueda por prefijo ----------
    def buscar_por_prefijo(self, prefijo: str) -> list:
        """Retorna (en orden alfabético) todas las palabras que empiezan con el prefijo."""
        p = normalizar(prefijo)
        resultado = []
        if not p:
            return resultado

        def recorrer(nodo):
            if nodo is None:
                return
            k = nodo.palabra.clave
            if k.startswith(p):
                recorrer(nodo.izq)
                resultado.append(nodo.palabra)
                recorrer(nodo.der)
            elif p < k:  # todas las coincidencias están a la izquierda
                recorrer(nodo.izq)
            else:        # todas las coincidencias están a la derecha
                recorrer(nodo.der)

        recorrer(self.raiz)
        return resultado

    # ---------- Recorrido en orden ----------
    def en_orden(self) -> list:
        resultado, pila, actual = [], [], self.raiz
        while pila or actual:
            while actual:
                pila.append(actual)
                actual = actual.izq
            actual = pila.pop()
            resultado.append(actual.palabra)
            actual = actual.der
        return resultado


