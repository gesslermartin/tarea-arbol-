def cargar_desde_archivo(ruta: str) -> list:
    """Opcional: carga líneas con formato 'palabra:definición' desde un .txt."""
    palabras = []
    with open(ruta, encoding="utf-8") as f:
        for linea in f:
            if ":" in linea:
                t, d = linea.split(":", 1)
                palabras.append(Palabra(t.strip(), d.strip()))
    return palabras


def menu():
    dic = DiccionarioBST()
    dic.cargar_balanceado([Palabra(t, d) for t, d in PALABRAS_INICIALES.items()])
    print(f"Diccionario cargado con {dic.tamano} palabras.")

    while True:
        print("\n=== DICCIONARIO INTELIGENTE ===")
        print("1. Buscar palabra exacta")
        print("2. Autocompletar por prefijo")
        print("3. Ver diccionario completo (A-Z)")
        print("4. Salir")
        opcion = input("Elige una opción: ").strip()

        if opcion == "1":
            texto = input("Palabra: ")
            p = dic.buscar(texto)
            if p:
                print(f"\n{p}")
            else:
                print("Palabra no encontrada.")
                sugeridas = dic.buscar_por_prefijo(texto[:2]) if len(texto) >= 2 else []
                if sugeridas:
                    print("¿Quisiste decir?: " + ", ".join(s.texto for s in sugeridas[:5]))
        elif opcion == "2":
            prefijo = input("Prefijo: ")
            res = dic.buscar_por_prefijo(prefijo)
            if res:
                print(f"\n{len(res)} resultado(s): " + ", ".join(p.texto for p in res))
            else:
                print("Sin coincidencias.")
        elif opcion == "3":
            for p in dic.en_orden():
                print(f"- {p}")
        elif opcion == "4":
            print("¡Hasta pronto!")
            break
        else:
            print("Opción inválida.")


if __name__ == "__main__":
    menu()
